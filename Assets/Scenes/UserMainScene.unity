  m_text: "\uCE90\uB9AD\uD130 \uBC30\uACBD\n\n\uC778\uAC04\uC774 \uC778\uCCB4 \uC2E4\uD5D8\uC73C\uB85C
    \uD0C4\uC0DD\uC2DC\uD0A8 \uCD5C\uCD08\uC758 \uD558\uD53C\uB85C, \uB3C5\uC218\uB9AC\uC758
    \uAC15\uD55C \uB2A5\uB825\uC744 \uC9C0\uB2CC\uB2E4. \uC778\uAC04\uACFC \uC678\uACC4\uC778\uC744
    \uBAA8\uB450 \uC99D\uC624\uD558\uC9C0\uB9CC, \uD558\uD53C\uC758 \uAC1C\uCCB4
    \uC218\uAC00 \uC801\uC5B4 \uC0DD\uC874\uC744 \uC704\uD574 \uC644\uC804\uD55C
    \uC801\uB300\uB294 \uD53C\uD55C\uB2E4. \uAC19\uC740 \uD558\uD53C\uB4E4\uC5D0\uAC8C\uB9CC
